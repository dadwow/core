# MySQL Configuration for Hetzner VPS
# Optimized for cloud VPS environment with SSD storage
# Assuming 4-8GB RAM VPS (adjust based on your actual VPS specs)

[mysqld]
# Basic Settings
port = 3306
socket = /var/run/mysqld/mysqld.sock
default-storage-engine = InnoDB
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# Connection Settings
max_connections = 200
max_connect_errors = 100
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 128M

# InnoDB Settings - Optimized for SSD and cloud environment
# Adjust innodb_buffer_pool_size based on your VPS RAM:
# - 4GB RAM: use 2G
# - 8GB RAM: use 4G
# - 16GB RAM: use 10G
innodb_buffer_pool_size = 4G
innodb_log_file_size = 512M
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_buffer_pool_instances = 4

# SSD Optimizations
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_flush_neighbors = 0  # Don't flush neighbors (good for SSD)
innodb_use_native_aio = 1

# Thread Settings
thread_cache_size = 32
thread_stack = 256K

# Table Cache
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 8000

# Temp Tables
tmp_table_size = 256M
max_heap_table_size = 256M

# Sort and Join Buffers
sort_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M
join_buffer_size = 4M

# MyISAM Settings
key_buffer_size = 128M
myisam_sort_buffer_size = 32M

# Logging (production)
log_error = /var/log/mysql/error.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 3
log_queries_not_using_indexes = 0

# Binary Logging
binlog_expire_logs_seconds = 604800  # 7 days
max_binlog_size = 500M
sync_binlog = 1

# Performance Schema
performance_schema = ON
performance_schema_max_table_instances = 2000

# Security
# bind-address = 0.0.0.0  # Uncomment to allow remote connections (use with firewall!)
skip-name-resolve = 1  # Skip DNS lookups for faster connections

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
port = 3306
socket = /var/run/mysqld/mysqld.sock
